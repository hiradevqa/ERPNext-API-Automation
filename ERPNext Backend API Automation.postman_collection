              "name": "Page 1 (Records 1–10)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const response = pm.response.json();\r\n\r\npm.test(\"Verify Page 1\", () => {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(response.data).to.be.an(\"array\");\r\n    pm.expect(response.data).to.have.lengthOf(10);\r\n});\r\n\r\nconst page1Ids = response.data.map(customer => customer.name);\r\n\r\npm.environment.set(\"page1Ids\", JSON.stringify(page1Ids));"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "\r\nconst prefix = \"QA-PAGE-\" + Date.now() + \"-\";\r\n\r\npm.environment.set(\"paginationPrefix\", prefix);\r\n\r\n// Get existing test Customer IDs\r\nconst ids = JSON.parse(\r\n    pm.environment.get(\"testCustomerIds\") || \"[]\"\r\n);\r\n\r\n// Create 20 temporary Customers\r\nfor (let i = 1; i <= 20; i++) {\r\n\r\n    const customerName = prefix + i;\r\n\r\n    const response = await pm.sendRequest({\r\n        url: pm.environment.get(\"base_url\") + \"/api/resource/Customer\",\r\n        method: \"POST\",\r\n        header: {\r\n            \"Content-Type\": \"application/json\",\r\n            \"Authorization\": \"token \" +\r\n                pm.environment.get(\"api_key\") + \":\" +\r\n                pm.environment.get(\"api_secret\")\r\n        },\r\n        body: {\r\n            mode: \"raw\",\r\n            raw: JSON.stringify({\r\n                customer_name: customerName,\r\n                customer_type: \"Company\"\r\n            })\r\n        }\r\n    });\r\n\r\n    // Stop if Customer creation failed\r\n    if (response.code !== 200 || !response.json().data?.name) {\r\n        throw new Error(\"Failed to create Customer \" + i);\r\n    }\r\n\r\n    // Save each Customer ID for cleanup\r\n    ids.push(response.json().data.name);\r\n\r\n    pm.environment.set(\r\n        \"testCustomerIds\",\r\n        JSON.stringify(ids)\r\n    );\r\n}\r\n\r\nconsole.log(\"Created 20 pagination Customers\");\r\n"
                    ]
                  }
                }
